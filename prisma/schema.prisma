generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                     String                 @id @default(uuid())
  employeeId             String                 @unique
  email                  String                 @unique
  password               String
  fullName               String
  phone                  String?
  role                   String                 @default("EMPLOYEE")
  designation            String                 @default("Staff Member")
  accountStatus          String                 @default("ACTIVE")
  mustChangePassword     Boolean                @default(false)
  isDeleted              Boolean                @default(false)
  teamId                 String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  employmentType         String                 @default("FULL_TIME")
  exitDate               DateTime?
  joiningDate            DateTime?              @default(now())
  announcementsCreated   Announcement[]         @relation("CreatedAnnouncements")
  announcementReads      AnnouncementRead[]
  attendances            Attendance[]
  auditLogs              AuditLog[]             @relation("UserAuditLogs")
  createdCalendarEntries CompanyCalendar[]      @relation("CreatedCalendarEntries")
  leaveApprovals         LeaveApprovalHistory[]
  leaveBalances          LeaveBalance[]
  leaveRequests          LeaveRequest[]
  notifications          Notification[]
  payrollRecords         PayrollRecord[]
  salaryRecords          SalaryRecord[]
  tasksCreated           Task[]                 @relation("CreatedTasks")
  tasksAssigned          Task[]                 @relation("AssignedTasks")
  ledTeams               Team[]                 @relation("TeamLead")
  team                   Team?                  @relation("TeamMembers", fields: [teamId], references: [id])
  pushSubscriptions      PushSubscription[]
  pushReminderLogs       PushReminderLog[]


  @@index([employeeId, email, role, teamId, accountStatus, isDeleted])
  @@index([updatedAt])
  @@index([teamId, updatedAt])
}

model Team {
  id         String   @id @default(uuid())
  name       String   @unique
  code       String   @unique
  isActive   Boolean  @default(true)
  teamLeadId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  teamLead   User?    @relation("TeamLead", fields: [teamLeadId], references: [id])
  members    User[]   @relation("TeamMembers")

  @@index([teamLeadId, isActive])
  @@index([updatedAt])
}

model Attendance {
  id             String    @id @default(uuid())
  userId         String
  date           DateTime
  checkInTime    DateTime?
  checkOutTime   DateTime?
  totalHours     Float     @default(0.0)
  status         String    @default("PRESENT")
  lateStatus     String    @default("ON_TIME")
  isCorrected    Boolean   @default(false)
  correctionNote String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date, status, lateStatus])
  @@index([updatedAt])
  @@index([userId, updatedAt])
}

model LeaveRequest {
  id           String                 @id @default(uuid())
  userId       String
  leaveType    String                 @default("CASUAL")
  startDate    DateTime
  endDate      DateTime
  numberOfDays Float
  reason       String
  currentStage String                 @default("PENDING_TL")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  approvedAt   DateTime?
  approvedById String?
  managerNote  String?
  payTreatment String?
  paidDays     Float?                 @default(0)
  unpaidDays   Float?                 @default(0)
  approvals    LeaveApprovalHistory[]
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, currentStage, startDate, endDate])
  @@index([updatedAt])
  @@index([userId, updatedAt])
}

model LeaveApprovalHistory {
  id             String       @id @default(uuid())
  leaveRequestId String
  actionById     String
  stage          String
  action         String
  comments       String?
  createdAt      DateTime     @default(now())
  actionBy       User         @relation(fields: [actionById], references: [id], onDelete: Cascade)
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  @@index([leaveRequestId, actionById])
}

model LeaveBalance {
  id         String @id @default(uuid())
  userId     String
  leaveType  String @default("CASUAL")
  totalQuota Float  @default(12.0)
  usedQuota  Float  @default(0.0)
  year       Int    @default(2026)
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveType, year])
  @@index([userId, year])
}

model Task {
  id            String    @id @default(uuid())
  taskCode      String    @unique
  title         String
  description   String?
  priority      String    @default("MEDIUM")
  status        String    @default("TO_DO")
  assignedToId  String?
  assignedById  String
  teamId        String?
  dueDate       DateTime?
  completedDate DateTime?
  workNotes     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  assignedBy    User      @relation("CreatedTasks", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedTo    User?     @relation("AssignedTasks", fields: [assignedToId], references: [id])

  @@index([assignedToId, assignedById, teamId, status])
}

model Announcement {
  id               String             @id @default(uuid())
  announcementCode String?            @unique
  title            String
  content          String
  priority         String             @default("NORMAL")
  targetType       String             @default("ALL")
  targetId         String?
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        User?              @relation("CreatedAnnouncements", fields: [createdById], references: [id])
  reads            AnnouncementRead[]

  @@index([targetType, targetId, createdById])
  @@index([updatedAt])
}

model AnnouncementRead {
  id             String       @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, announcementId])
}

model SystemSetting {
  id                  String   @id @default("global_config")
  companyName         String   @default("Persevex Systems Corp")
  companyEmail        String   @default("admin@persevex.com")
  officeStartTime     String   @default("11:00")
  officeEndTime       String   @default("20:00")
  gracePeriodMinutes  Int      @default(15)
  workingDays         String   @default("Monday,Tuesday,Thursday,Friday,Saturday,Sunday")
  officeLatitude      String?  @default("12.916480")
  officeLongitude     String?  @default("77.618145")
  officeRadiusMeters  String?  @default("100")
  enableLocationCheck Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  role      String
  action    String
  target    String
  details   String
  timestamp DateTime @default(now())
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId, action, timestamp])
  @@index([timestamp])
}

model CompanyCalendar {
  id          String   @id @default(uuid())
  date        DateTime
  dateKey     String   @unique
  type        String
  title       String
  description String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("CreatedCalendarEntries", fields: [createdById], references: [id])

  @@index([dateKey, type])
  @@index([date])
}

model SalaryRecord {
  id             String    @id @default(uuid())
  userId         String
  baseSalary     Float
  employmentType String    @default("FULL_TIME")
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  notes          String?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, effectiveFrom, effectiveTo])
  @@index([userId, updatedAt])
}

model PayrollRecord {
  id              String    @id @default(uuid())
  userId          String
  year            Int
  month           Int
  monthKey        String
  baseSalary      Float
  employmentType  String    @default("FULL_TIME")
  calendarDays    Int
  weeklyOffs      Int
  companyHolidays Int
  workingDays     Int
  presentDays     Float     @default(0.0)
  paidLeaveDays   Float     @default(0.0)
  unpaidLeaveDays Float     @default(0.0)
  dailyRate       Float     @default(0.0)
  unpaidDeduction Float     @default(0.0)
  finalPayable    Float     @default(0.0)
  status          String    @default("DRAFT")
  finalizedAt     DateTime?
  finalizedById   String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month])
  @@index([monthKey, status])
  @@index([userId, monthKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// Push Notification Models (Punch-In Reminder Feature)
// ─────────────────────────────────────────────────────────────────────────────

/// One row per authenticated browser/device subscription.
/// An employee may have multiple rows (laptop + phone).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endpoint])
}

/// One row per (userId, dateKey, endpoint) triple.
/// Prevents the same device from receiving duplicate reminders
/// if the cron endpoint is retried or invoked concurrently.
model PushReminderLog {
  id        String   @id @default(uuid())
  userId    String
  dateKey   String
  endpoint  String
  sentAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateKey, endpoint])
  @@index([userId, dateKey])
  @@index([dateKey])
}

